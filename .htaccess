# =============================================================================
# .htaccess — Configurações do Apache para PibPirajui
# Hostgator / Apache
# =============================================================================

# Habilita o módulo de reescrita de URL
Options -Indexes
RewriteEngine On

# -----------------------------------------------------------------------------
# SEGURANÇA: Bloqueia acesso direto a pastas sensíveis
# Usuários não devem conseguir acessar esses arquivos pelo navegador
# -----------------------------------------------------------------------------
RewriteRule ^includes/.*$   - [F,L]
RewriteRule ^php/crud/.*$   - [F,L]
RewriteRule ^admin/includes/.*$ - [F,L]

# Bloqueia acesso a arquivos com extensões sensíveis
<FilesMatch "\.(sql|log|sh|bak|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# -----------------------------------------------------------------------------
# WWW: Redireciona sem www para com www (ou vice-versa, ajuste conforme necessário)
# Descomente o bloco desejado após configurar o domínio
# -----------------------------------------------------------------------------
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -----------------------------------------------------------------------------
# HTTPS: Força HTTPS em produção
# Descomente após instalar o certificado SSL na Hostgator
# -----------------------------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -----------------------------------------------------------------------------
# CHARSET e headers de segurança
# -----------------------------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# -----------------------------------------------------------------------------
# CACHE de assets estáticos (CSS, JS, imagens)
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg     "access plus 1 year"
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType text/css      "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Página de erro personalizada
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
